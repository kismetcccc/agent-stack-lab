# Preferred Compose setup: python scripts/infra-init-env.py
# It creates private .env with random service credentials; never commit .env.
MYSQL_ROOT_PASSWORD=replace-with-random-local-value
MYSQL_PASSWORD=replace-with-random-local-value
MONGO_PASSWORD=replace-with-random-local-value
REDIS_PASSWORD=replace-with-random-local-value

# Direct process configuration (Compose supplies its own internal service URLs):
LAB_MODE=production
DATABASE_URL=mysql+pymysql://lab:replace-locally@mysql:3306/agentlab
MONGO_URL=mongodb://root:replace-locally@mongo:27017/?authSource=admin
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_URL=redis://:replace-locally@redis:6379/0
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
MODEL_MODE=deterministic
ALLOW_LIVE_MODEL=false
# Configure live calls only after authorization; never paste a real key into tracked files.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
LEASE_SECONDS=120
MAX_ATTEMPTS=3
KAFKA_TOPIC=agent.tasks
KAFKA_DLQ_TOPIC=agent.tasks.dlq
